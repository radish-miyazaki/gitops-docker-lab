entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  docker:
    # ラベルを付けたコンテナだけ公開する
    exposedByDefault: false
    network: ${network}
  file:
    directory: /etc/traefik/dynamic
    watch: true

api:
  # ダッシュボード自体は有効だが、router を定義していないのでホストからは開けない（ADR 0011）
  dashboard: true

log:
  level: INFO
